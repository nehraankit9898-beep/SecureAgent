{
  "name": "secureagent-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "SecureAgent Linux desktop shell",
  "main": "main.js",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=9 <12"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --linux AppImage deb tar.gz --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.secureagent.desktop",
    "productName": "SecureAgent",
    "artifactName": "SecureAgent-Setup.${ext}",
    "asar": true,
    "directories": {
      "output": "../build/electron-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipc/**/*",
      "services/**/*",
      "windows/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/backend-build/",
        "to": "backend",
        "filter": [
          "SecureAgentBackend"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "SecureAgent",
      "artifactName": "SecureAgent-${version}-${arch}.${ext}",
      "synopsis": "Local-first SecureAgent desktop app"
    },
    "deb": {
      "depends": ["bubblewrap"]
    }
  }
}
