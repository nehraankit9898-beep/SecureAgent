# SecureAgent local development configuration.
# Copy this file to .env. Paths are resolved from this project directory,
# never from the shell's current working directory.
SECURE_AGENT_ENVIRONMENT=development
SECURE_AGENT_AUTH_REQUIRED=false
SECURE_AGENT_ALLOW_UNAUTHENTICATED_LOCALHOST=true

# Optional local authentication. To enable it, set AUTH_REQUIRED=true and
# generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECURE_AGENT_API_TOKEN=

# Ollama is local and does not use the SecureAgent API token.
SECURE_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SECURE_AGENT_OLLAMA_ENABLED=true
SECURE_AGENT_ALLOW_REMOTE_OLLAMA=false
SECURE_AGENT_OLLAMA_MODEL=llama3.2
SECURE_AGENT_EMBEDDING_MODEL=nomic-embed-text
SECURE_AGENT_MAX_LLM_COMPLETION_TOKENS=16384
SECURE_AGENT_LLM_TIMEOUT_SECONDS=120

SECURE_AGENT_DATABASE_PATH=data/secure_agent.db
SECURE_AGENT_WORKSPACE_ROOT=workspace
SECURE_AGENT_AGENT_ENABLED=true
SECURE_AGENT_AUTONOMOUS_MODE=false
SECURE_AGENT_TOOLS_ENABLED=true
SECURE_AGENT_FILESYSTEM_TOOLS_ENABLED=true
SECURE_AGENT_CODING_TOOLS_ENABLED=true
SECURE_AGENT_TERMINAL_TOOLS_ENABLED=false
# Terminal backend: 'docker' (original sandboxed terminal) or 'linux'
# (Linux-native terminal agent: command policy engine + /bin/bash inside the
# approved workspace). Both are gated by TERMINAL_TOOLS_ENABLED.
SECURE_AGENT_TERMINAL_BACKEND=linux
SECURE_AGENT_TERMINAL_SHELL=/bin/bash
# Extra absolute directories the Linux terminal may use as working directories
# (the workspace root is always allowed). / is never allowed.
# SECURE_AGENT_TERMINAL_ALLOWED_PATHS=["/home/user/projects"]
SECURE_AGENT_TERMINAL_COMMAND_TIMEOUT_SECONDS=30
SECURE_AGENT_TERMINAL_MAX_OUTPUT_BYTES=200000
SECURE_AGENT_TERMINAL_HISTORY_LIMIT=1000
# sudo attempts run non-interactively (sudo -n); SecureAgent never collects,
# stores, or logs sudo passwords.
SECURE_AGENT_TERMINAL_ALLOW_SUDO=true
SECURE_AGENT_SECURITY_WORKFLOWS_ENABLED=true
SECURE_AGENT_PLUGINS_ENABLED=false
SECURE_AGENT_MEMORY_ENABLED=true
SECURE_AGENT_KNOWLEDGE_ENABLED=true
SECURE_AGENT_ENABLE_NETWORK_TOOLS=false
SECURE_AGENT_ENABLE_AUTOMATION=false
SECURE_AGENT_PYTHON_EXECUTION_BACKEND=disabled
# Required when PYTHON_EXECUTION_BACKEND=docker. Always pin by digest.
# SECURE_AGENT_PYTHON_SANDBOX_IMAGE=python:3.13-alpine@sha256:<64-hex-digest>
SECURE_AGENT_TEST_SANDBOX_ENABLED=false
# Required when TEST_SANDBOX_ENABLED=true. The same locked-down sandbox powers
# Terminal and Test Runner; always pin the image by digest.
# SECURE_AGENT_TEST_SANDBOX_IMAGE=python:3.13-alpine@sha256:<64-hex-digest>

# Network policy is fail-closed. Enabling network access also requires a mode,
# an allowed address class, and (for search) a trusted SearXNG URL.
SECURE_AGENT_NETWORK_MODE=disabled
SECURE_AGENT_WEB_SEARCH_ENABLED=false
SECURE_AGENT_HTTP_REQUESTS_ENABLED=false
SECURE_AGENT_DNS_ENABLED=true
SECURE_AGENT_REQUIRE_APPROVAL_FOR_EXTERNAL_NETWORK=true
SECURE_AGENT_NETWORK_TIMEOUT_SECONDS=12
SECURE_AGENT_NETWORK_MAX_RESPONSE_BYTES=1000000
SECURE_AGENT_NETWORK_RATE_LIMIT_PER_MINUTE=20
SECURE_AGENT_ALLOW_LOCAL_NETWORK=false
SECURE_AGENT_ALLOW_PRIVATE_NETWORK=false
SECURE_AGENT_ALLOW_EXTERNAL_NETWORK=false
# SECURE_AGENT_SEARXNG_BASE_URL=http://127.0.0.1:8080

# Automation remains off until explicitly enabled. High-risk operations always
# require approval; this setting cannot be disabled.
SECURE_AGENT_AUTOMATION_REQUIRE_APPROVAL=true
SECURE_AGENT_AUTOMATION_MAX_CONCURRENT_JOBS=2
SECURE_AGENT_AUTOMATION_MAX_RUNTIME_SECONDS=300
SECURE_AGENT_SCHEDULER_POLL_SECONDS=10
SECURE_AGENT_APPROVAL_MODE=high-risk
SECURE_AGENT_REQUIRE_APPROVAL_FOR_HIGH_RISK=true
